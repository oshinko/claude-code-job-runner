CLAUDE_CODE_VERSION=2.1.233
CONTAINER_UID=10001
CONTAINER_GID=10001

PROJECT_LOCATION=https://github.com/example/project.git
GIT_REVISION=
# Optional. Askpass offers the token only to the GITHUB_SERVER_URL host.
GITHUB_TOKEN=
# Defaults to https://github.com when GITHUB_TOKEN is set.
GITHUB_SERVER_URL=

# For compose.override.local.yaml, copy it to compose.override.yaml and set:
# PROJECT_LOCATION=/workspace/local-project

MAX_TURNS=30
MAX_BUDGET_USD=
CLAUDE_MODEL=
PROMPT=

# Set exactly one of these two values.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
