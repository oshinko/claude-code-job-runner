CLAUDE_CODE_VERSION=2.1.233
CONTAINER_UID=10001
CONTAINER_GID=10001

REPOSITORY_URL=https://github.com/example/project.git
REPOSITORY_REVISION=
# Optional. Askpass offers the token only to the GITHUB_SERVER_URL host.
GITHUB_TOKEN=
# Defaults to https://github.com when GITHUB_TOKEN is set.
GITHUB_SERVER_URL=

# For compose.override.local.yaml, copy it to compose.override.yaml and set:
# REPOSITORY_URL=/workspace/local-repository

MAX_TURNS=30
MAX_BUDGET_USD=
CLAUDE_MODEL=
PROMPT=

# Set exactly one authentication method: Claude OAuth, Anthropic API key, or WIF.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Workload Identity Federation (WIF). Set the three IDs and exactly one of the
# identity token inputs. Prefer a rotating token file for long-running jobs.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_IDENTITY_TOKEN_FILE=
ANTHROPIC_IDENTITY_TOKEN=
